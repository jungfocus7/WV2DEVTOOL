{
  "compilerOptions": {
    // ===================================================================
    // 1. **환경 정의 및 타입 체크 (핵심)**
    // ===================================================================

    // Node.js API (process, Buffer, fs 등)에 대한 타입 정의를 로드합니다.
    "types": ["node"],
    
    // 브라우저 DOM API를 제외하고, 최신 JS 표준 API만 사용할 수 있도록 정의합니다.
    "lib": ["ESNext"],
    
    // 순수 JavaScript 파일(.js)에서도 TypeScript의 타입 검사 기능을 활성화합니다.
    "checkJs": true,
    
    // 프로젝트에 JavaScript 파일(.js, .jsx)이 포함되어 있음을 허용합니다.
    "allowJs": true,
    
    // ===================================================================
    // 2. **모듈 시스템 (최신 ESM 권장)**
    // ===================================================================
    
    // 모듈 구문(import/export)을 최신 ESM 방식("module": "ESNext")으로 처리합니다.
    "module": "ESNext",
    
    // Node.js의 최신 ESM 규칙을 사용하여 모듈 경로를 해석합니다.
    "moduleResolution": "NodeNext",
    
    // CommonJS 라이브러리를 ESM 문법으로 가져올 때 호환성 문제를 자동으로 해결합니다.
    "esModuleInterop": true,
    
    // ===================================================================
    // 3. **출력 및 문법 수준 (최신 JS 사용)**
    // ===================================================================

    // 최종 코드를 어떤 JS 버전의 문법으로 처리할지 결정합니다. 최신 버전을 유지합니다.
    "target": "ESNext",
    
    // pnpm 또는 Yarn PnP 환경에서 모듈을 찾을 때 필요한 옵션입니다.
    "preserveSymlinks": true,

    // 소스맵 생성을 비활성화합니다.
    "sourceMap": false,
    
    // ===================================================================
    // 4. **경로 및 기타 설정**
    // ===================================================================

    // 프로젝트의 베이스 URL을 설정하여 절대 경로 가져오기를 활성화합니다.
    // (예: import 'components/Button.js' 형태의 절대 경로를 인식하게 함)
    "baseUrl": "." 
  },
  
  // 프로젝트 내의 모든 JS 파일을 언어 서비스의 분석 대상에 포함합니다.
  "include": [
    "**/*.js",
    "**/*.mjs" // Node.js ESM 파일도 포함
  ],
  
  // 무시할 폴더 및 파일 (일반적인 Node.js 프로젝트 설정)
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "build"
  ]
}