{
    // IntelliSense를 사용하여 가능한 특성에 대해 알아보세요.
    // 기존 특성에 대한 설명을 보려면 가리킵니다.
    // 자세한 내용을 보려면 https://go.microsoft.com/fwlink/?linkid=830387을(를) 방문하세요.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "jsrun",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeArgs": [
                "--max-old-space-size=32768",
                "--abort-on-uncaught-exception",
                "--trace-gc",
                "--trace-warnings",
                "--trace-uncaught",
            ],
            "env": {
                "NODE_DEBUG": "*"
            },
            "program": "${file}",
        },
    ]
}