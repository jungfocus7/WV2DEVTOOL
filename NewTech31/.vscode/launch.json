    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "jsrun",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${file}",
            "runtimeArgs": [
                "--max-old-space-size=8192",
                // "--trace-gc",
                // "--heapsnapshot-on-oom",  // OOM 시 .heapsnapshot 파일 자동 생성
                // "--expose-gc"             // 코드에서 global.gc() 호출 가능
            ],
            "env": {
                "NODE_ENV": "development"
            },
            "outputCapture": "std"        // stdout/stderr 모두 캡처
        }
    ]
}